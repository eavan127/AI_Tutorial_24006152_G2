<mxfile host="app.diagrams.net">
  <diagram name="Semantic Network" id="semnet">
    <mxGraphModel dx="1000" dy="650" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="650" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Nodes -->
        <mxCell id="airline" value="Airline" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="240" width="150" height="60" as="geometry" />
        </mxCell>
        <mxCell id="flight" value="Flight" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=16;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="410" y="235" width="160" height="70" as="geometry" />
        </mxCell>
        <mxCell id="passenger" value="Passenger" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="470" width="150" height="60" as="geometry" />
        </mxCell>
        <mxCell id="deptime" value="Departure Time" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="270" y="40" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="dest" value="Destination" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="550" y="40" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="cancelled" value="Cancelled" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="800" y="140" width="150" height="60" as="geometry" />
        </mxCell>
        <mxCell id="delayed" value="Delayed (Delay)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="800" y="330" width="150" height="60" as="geometry" />
        </mxCell>
        <mxCell id="complaint" value="Passenger Complaint" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="400" y="470" width="180" height="60" as="geometry" />
        </mxCell>

        <!-- Labelled relationships -->
        <mxCell id="e1" value="operates" style="endArrow=classic;html=1;fontSize=13;fontStyle=2;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="airline" target="flight">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="books" style="endArrow=classic;html=1;fontSize=13;fontStyle=2;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="passenger" target="flight">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="has" style="endArrow=classic;html=1;fontSize=13;fontStyle=2;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="flight" target="deptime">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="has" style="endArrow=classic;html=1;fontSize=13;fontStyle=2;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="flight" target="dest">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="can be" style="endArrow=classic;html=1;fontSize=13;fontStyle=2;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="flight" target="cancelled">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="can be" style="endArrow=classic;html=1;fontSize=13;fontStyle=2;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="flight" target="delayed">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" value="may cause" style="endArrow=classic;html=1;fontSize=13;fontStyle=2;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="delayed" target="complaint">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" value="makes" style="endArrow=classic;html=1;fontSize=13;fontStyle=2;labelBackgroundColor=#ffffff;strokeWidth=1.5;dashed=1;" edge="1" parent="1" source="passenger" target="complaint">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Legend -->
        <mxCell id="legend" value="Solid arrow = given relationship&lt;br&gt;Dashed arrow = additional relationship (own)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="680" y="560" width="290" height="40" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
